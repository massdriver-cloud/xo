{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "checkov",
          "version": "3.2.0",
          "rules": [
            {
              "id": "CKV_AWS_16",
              "name": "Ensure RDS database has encryption at rest enabled"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CKV_AWS_16",
          "level": "error",
          "message": { "text": "RDS instance is not encrypted at rest" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "main.tf" },
                "region": { "startLine": 1 }
              }
            }
          ]
        }
      ]
    }
  ]
}
